# Copy this file to .env in the same folder as omira.py

OMIRA_FAST_MODE=1
OMIRA_SPEECH_RATE=220

# Terminal stays silent by default (only "Hello sir." is spoken at startup).
# Set to 1 temporarily if you need to see what Omira is doing internally.
OMIRA_VERBOSE=0

# ONE single Indian-accented voice used for English, Hindi, AND Marathi —
# on every TTS path (edge-tts, the PowerShell fallback, and the offline
# pyttsx3 last resort). Needs `pip install -r requirements.txt` to actually
# install edge-tts + playsound, or Omira falls back to a different voice.
# Male alternative: hi-IN-MadhurNeural
OMIRA_EDGE_VOICE=hi-IN-SwaraNeural
# Backs the PowerShell/pyttsx3 fallback voice selection — keep the language
# prefix in sync with OMIRA_EDGE_VOICE above (e.g. both "hi-IN"/"hi-IN-...").
OMIRA_VOICE_CULTURE=hi-IN

# --- AI backend (Q&A, document writing, action planning) ---
# Tried in this order: Gemini -> OpenAI -> local Ollama. You only need ONE,
# but if you rely on Gemini's free tier alone, it WILL hit its daily quota
# (429 errors) sooner or later — configuring OpenAI or running Ollama
# locally as a second backend is the only way to guarantee Omira always
# answers.
GEMINI_API_KEY=
# Leave blank to let Omira try several known-good models in order and
# remember whichever one works (recommended — Google renames/retires model
# IDs often, and a hardcoded name here can suddenly 404). Only set this if
# you specifically want to force one exact model.
OMIRA_GEMINI_MODEL=gemini-2.5-flash
# Seconds to stop calling Gemini after every candidate model returns a 429,
# so an exhausted quota doesn't get hit again on every single command.
OMIRA_GEMINI_COOLDOWN_SECONDS=90

OPENAI_API_KEY=your_openai_api_key_here
OMIRA_OPENAI_MODEL=gpt-4o-mini

OMIRA_OLLAMA_URL=http://localhost:11434/api/chat
OMIRA_OLLAMA_MODEL=llama3.1

# --- OMIRA orb status feed (status_bridge.py) ---
# Local-only, read-only WebSocket that lets the OMIRA orb UI show Omira's
# current state (idle/listening/processing/responding/error). Bound to
# 127.0.0.1 by default — not reachable from your network. The OMIRA
# frontend's NEXT_PUBLIC_OMIRA_WS_URL must point at the same host/port.
OMIRA_STATUS_WS_HOST=127.0.0.1
OMIRA_STATUS_WS_PORT=8765

# --- Gmail (send, check, read, reply) ---
# 1) Turn on 2-Step Verification on your Google account.
# 2) Create an App Password: myaccount.google.com/apppasswords
# 3) Enable IMAP: Gmail Settings -> Forwarding and POP/IMAP -> Enable IMAP
OMIRA_EMAIL_ADDRESS=youraddress@gmail.com
OMIRA_EMAIL_PASSWORD=your_16_char_app_password

# --- WhatsApp (send by contact name, via contacts.json) ---
# Seconds pywhatkit waits for web.whatsapp.com to load before typing and
# sending the message. Bump this up if it's typing before the page/chat
# has fully loaded on a slower connection.
OMIRA_WHATSAPP_WAIT_SECONDS=20

# Language Omira starts up listening in: english, hindi, or marathi.
# Switch anytime by saying "speak in hindi" / "speak in marathi" / "speak in english".
OMIRA_DEFAULT_LANGUAGE=english
